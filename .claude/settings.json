{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/cloud_session_start.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npm --prefix functions *)",
      "Bash(git submodule *)",
      "Bash(firebase *)",
      "Bash(gcloud *)",
      "Bash(curl *)"
    ]
  }
}
