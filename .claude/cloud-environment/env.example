# ==============================================================================
# Claude Code Cloud Environment Variables for activitypub-firebase
# Copy the contents of this file into the "Environment variables" textarea
# in the Claude Code Cloud Environment dialog (https://claude.ai/code).
# ==============================================================================

# --- Timeout Configurations ---
# npm test (全テスト実行) やビルド、Firebase デプロイのために長めのタイムアウトを設定 (ミリ秒)
BASH_DEFAULT_TIMEOUT_MS=600000
BASH_MAX_TIMEOUT_MS=1800000

# --- Node & System Configurations ---
# NODE_ENV は設定しないこと。vitest は NODE_ENV が未設定のときだけ test を入れるため、
# ここで development などを入れるとテスト用の分岐 (src/webfinger.ts など) が無効になり、テストが落ちる。
# Firestore エミュレータ等のための Java 設定 (Ubuntu 24.04 の OpenJDK 21)
JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64
# firebase CLI や node 関連ツールの PATH
PATH=/usr/local/bin:/usr/bin:/bin:/opt/node22/bin:/root/.cache/firebase/bin

# --- GCP / Firebase Project Configurations ---
# dev 環境 (activitypub-firebase-dev) を明示指定して本番誤爆を防ぐ
GCLOUD_PROJECT=activitypub-firebase-dev
PROJECT_ID=activitypub-firebase-dev
FIREBASE_PROJECT=activitypub-firebase-dev

# --- Endpoints for Development & Federation Testing ---
DEV=https://activitypub-dev.hakatashi.com
ACTOR=https://activitypub-dev.hakatashi.com/activitypub/u/hakatashi
REMOTE=https://mastodon-test.hakatashi.com
MISSKEY_REMOTE=https://misskey-test.hakatashi.com

# --- Authentication & API Tokens (Optional / Fallback) ---
# ※ Network Secrets を設定する場合、HTTP リクエストには自動的にトークンが付与されます。
# スクリプト (functions/bin/*.ts 等) が process.env を直接参照して署名やヘッダーを組み立てる場合は、
# ここにも対応するトークン値を設定してください。
REMOTE_TOKEN=
HAKATASHI_TOKEN=
MASTODON_DEV_TOKEN=
MISSKEY_REMOTE_TOKEN=

# --- Service Account Key (for GCP / Firebase CLI deployment) ---
# クラウドセッションから dev 環境への手動デプロイ (firebase deploy) や
# gcloud tasks / gcloud secrets の参照を行わせるため、
# activitypub-firebase-dev のサービスアカウントキー JSON を1行で設定します。
# 例: GCP_SA_KEY={"type":"service_account",...}
GCP_SA_KEY=
