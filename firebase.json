{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "hosting": [
    {
      "target": "activitypub",
      "public": "public",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "/.well-known/**",
          "function": {
            "functionId": "activitypub",
            "region": "asia-northeast1"
          }
        },
        {
          "source": "/activitypub/**",
          "function": {
            "functionId": "activitypub",
            "region": "asia-northeast1"
          }
        },
        {
          "source": "/nodeinfo/**",
          "function": {
            "functionId": "activitypub",
            "region": "asia-northeast1"
          }
        }
      ]
    },
    {
      "target": "mastodon",
      "public": "public",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "/api/**",
          "headers": [
            {
              "key": "Access-Control-Allow-Origin",
              "value": "*"
            }
          ]
        }
      ],
      "redirects": [
        {
          "source": "/",
          "destination": "https://hakatashi.com/",
          "type": 301
        },
        {
          "source": "/.well-known/webfinger",
          "destination": "https://hakatashi.com/.well-known/webfinger",
          "type": 301
        }
      ],
      "rewrites": [
        {
          "source": "/api/v1/accounts/update_credentials",
          "function": {
            "functionId": "mediaUploadApi",
            "region": "asia-northeast1"
          }
        },
        {
          "source": "/api/v1/media",
          "function": {
            "functionId": "mediaUploadApi",
            "region": "asia-northeast1"
          }
        },
        {
          "source": "/api/v1/media/**",
          "function": {
            "functionId": "mediaUploadApi",
            "region": "asia-northeast1"
          }
        },
        {
          "source": "/api/v2/media",
          "function": {
            "functionId": "mediaUploadApi",
            "region": "asia-northeast1"
          }
        },
        {
          "source": "/api/v2/media/**",
          "function": {
            "functionId": "mediaUploadApi",
            "region": "asia-northeast1"
          }
        },
        {
          "source": "/api/**",
          "function": {
            "functionId": "mastodonApi",
            "region": "asia-northeast1"
          }
        },
        {
          "source": "/oauth/**",
          "function": {
            "functionId": "mastodonApi",
            "region": "asia-northeast1"
          }
        },
        {
          "source": "/.well-known/nodeinfo",
          "function": {
            "functionId": "mastodonApi",
            "region": "asia-northeast1"
          }
        },
        {
          "source": "/nodeinfo/:version*",
          "function": {
            "functionId": "mastodonApi",
            "region": "asia-northeast1"
          }
        },
        {
          "source": "/tags/**",
          "function": {
            "functionId": "mastodonApi",
            "region": "asia-northeast1"
          }
        },
        {
          "source": "/avatars/original/missing.png",
          "function": {
            "functionId": "mastodonApi",
            "region": "asia-northeast1"
          }
        },
        {
          "source": "/headers/original/missing.png",
          "function": {
            "functionId": "mastodonApi",
            "region": "asia-northeast1"
          }
        },
        {
          "regex": "^/@[^/]+(?:/[0-9]+)?/?$",
          "function": {
            "functionId": "mastodonApi",
            "region": "asia-northeast1"
          }
        }
      ]
    },
    {
      "target": "bots",
      "public": "hosting/bots",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "/api/**",
          "headers": [
            {
              "key": "Access-Control-Allow-Origin",
              "value": "*"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "/.well-known/**",
          "function": {
            "functionId": "activitypub",
            "region": "asia-northeast1"
          }
        },
        {
          "source": "/activitypub/**",
          "function": {
            "functionId": "activitypub",
            "region": "asia-northeast1"
          }
        },
        {
          "source": "/nodeinfo/**",
          "function": {
            "functionId": "activitypub",
            "region": "asia-northeast1"
          }
        },
        {
          "source": "/api/v1/accounts/update_credentials",
          "function": {
            "functionId": "mediaUploadApi",
            "region": "asia-northeast1"
          }
        },
        {
          "source": "/api/v1/media",
          "function": {
            "functionId": "mediaUploadApi",
            "region": "asia-northeast1"
          }
        },
        {
          "source": "/api/v1/media/**",
          "function": {
            "functionId": "mediaUploadApi",
            "region": "asia-northeast1"
          }
        },
        {
          "source": "/api/v2/media",
          "function": {
            "functionId": "mediaUploadApi",
            "region": "asia-northeast1"
          }
        },
        {
          "source": "/api/v2/media/**",
          "function": {
            "functionId": "mediaUploadApi",
            "region": "asia-northeast1"
          }
        },
        {
          "source": "/api/**",
          "function": {
            "functionId": "mastodonApi",
            "region": "asia-northeast1"
          }
        },
        {
          "source": "/oauth/**",
          "function": {
            "functionId": "mastodonApi",
            "region": "asia-northeast1"
          }
        },
        {
          "source": "/tags/**",
          "function": {
            "functionId": "mastodonApi",
            "region": "asia-northeast1"
          }
        },
        {
          "source": "/avatars/original/missing.png",
          "function": {
            "functionId": "mastodonApi",
            "region": "asia-northeast1"
          }
        },
        {
          "source": "/headers/original/missing.png",
          "function": {
            "functionId": "mastodonApi",
            "region": "asia-northeast1"
          }
        },
        {
          "regex": "^/@[^/]+(?:/[0-9]+)?/?$",
          "function": {
            "functionId": "mastodonApi",
            "region": "asia-northeast1"
          }
        }
      ]
    }
  ],
  "emulators": {
    "firestore": {
      "host": "0.0.0.0",
      "port": 34567
    }
  }
}
