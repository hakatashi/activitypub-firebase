{
	"compilerOptions": {
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"noImplicitReturns": true,
		"noUnusedLocals": true,
		"outDir": "lib",
		"sourceMap": true,
		"strict": true,
		"target": "ESNext",
		"lib": ["ESNext"],
		"esModuleInterop": true,
		"skipLibCheck": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"noImplicitOverride": true,
		"allowJs": true
	},
	"ts-node": {
		"esm": true,
		"require": ["tsconfig-paths/register"]
	},
	"compileOnSave": true,
	"include": ["src", "types"]
}
