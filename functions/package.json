{
  "name": "functions",
  "scripts": {
    "lint": "eslint .",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "firebase emulators:exec --project activitypub-firebase-dev --only firestore \"cross-env GCLOUD_PROJECT=activitypub-firebase-dev node --experimental-vm-modules node_modules/jest/bin/jest --runInBand\"",
    "test:watch": "firebase emulators:exec --project activitypub-firebase-dev --only firestore \"cross-env GCLOUD_PROJECT=activitypub-firebase-dev node --experimental-vm-modules node_modules/jest/bin/jest --runInBand --watchAll\""
  },
  "engines": {
    "node": "22"
  },
  "type": "module",
  "main": "lib/index.js",
  "dependencies": {
    "@google-cloud/functions-framework": "^3.5.1",
    "@node-oauth/oauth2-server": "^4.3.3",
    "activitypub-express": "4.4.1",
    "cors": "^2.8.6",
    "escape-goat": "^4.0.0",
    "express": "^4.22.2",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^6.6.0",
    "lodash-es": "^4.18.1",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@google-cloud/firestore": "^6.8.0",
    "@hakatashi/eslint-config": "^2.1.1",
    "@jest/globals": "^30.5.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jest": "^30.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/supertest": "^2.0.16",
    "activitypub-types": "^1.1.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "firebase-tools": "^15.29.0",
    "jest": "^30.5.1",
    "masto": "^5.11.4",
    "supertest": "^6.3.4",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "private": true
}
