{
	"name": "functions",
	"private": true,
	"type": "module",
	"main": "lib/index.js",
	"scripts": {
		"lint": "oxlint .",
		"format": "oxfmt --write .",
		"format:check": "oxfmt --check .",
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.json",
		"build:watch": "tsc -p tsconfig.build.json --watch",
		"serve": "npm run build && firebase emulators:start --only functions",
		"shell": "npm run build && firebase functions:shell",
		"start": "npm run shell",
		"deploy": "firebase deploy --only functions",
		"logs": "firebase functions:log",
		"test": "firebase emulators:exec --project activitypub-firebase-dev --only firestore \"cross-env GCLOUD_PROJECT=activitypub-firebase-dev vitest run\"",
		"test:changed": "firebase emulators:exec --project activitypub-firebase-dev --only firestore \"cross-env GCLOUD_PROJECT=activitypub-firebase-dev vitest run --changed\"",
		"test:changed:main": "firebase emulators:exec --project activitypub-firebase-dev --only firestore \"cross-env GCLOUD_PROJECT=activitypub-firebase-dev vitest run --changed origin/main\"",
		"test:only": "node bin/run-test.js",
		"test:watch": "firebase emulators:exec --project activitypub-firebase-dev --only firestore \"cross-env GCLOUD_PROJECT=activitypub-firebase-dev vitest\""
	},
	"dependencies": {
		"@google-cloud/functions-framework": "^3.5.1",
		"@node-oauth/oauth2-server": "^4.3.3",
		"blurhash": "^2.0.5",
		"busboy": "^1.6.0",
		"cors": "^2.8.6",
		"deepmerge": "^4.2.2",
		"escape-goat": "^4.0.0",
		"express": "^5.2.1",
		"firebase-admin": "^13.10.0",
		"firebase-functions": "^6.6.0",
		"http-message-sig": "^0.3.0",
		"ipaddr.js": "^1.9.1",
		"jsonld": "^8.1.0",
		"lodash-es": "^4.18.1",
		"node-fetch": "^3.3.2",
		"on-finished": "^2.4.1",
		"overlaps": "^1.0.0",
		"qs": "^6.16.0",
		"sharp": "^0.35.5",
		"undici": "^6.28.1",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@google-cloud/firestore": "^6.8.0",
		"@hakatashi/oxlint-config": "^0.1.0",
		"@types/busboy": "^1.5.4",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/http-signature": "^1.4.0",
		"@types/jsonld": "^1.5.15",
		"@types/lodash-es": "^4.17.12",
		"@types/nock": "^10.0.3",
		"@types/on-finished": "^2.3.5",
		"@types/qs": "^6.15.1",
		"@types/supertest": "^2.0.16",
		"activitypub-types": "^1.1.0",
		"cross-env": "^7.0.3",
		"firebase-tools": "^15.29.0",
		"http-signature": "^1.4.0",
		"masto": "^5.11.4",
		"nock": "^14.0.17",
		"oxfmt": "^0.66.0",
		"oxlint": "^1.81.0",
		"supertest": "^6.3.4",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.9.3",
		"vite": "^7.3.6",
		"vitest": "^4.1.11"
	},
	"engines": {
		"node": "22"
	}
}
