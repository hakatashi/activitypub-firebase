{
	"extends": ["./node_modules/@hakatashi/oxlint-config/index.json"],
	"ignorePatterns": ["lib/**/*", "test/apex-upstream/**/*"],
	"env": {
		"node": true,
		"es2022": true
	},
	"rules": {
		"import/no-namespace": "off",
		"import/no-named-as-default-member": "off",
		"no-underscore-dangle": [
			"error",
			{
				"allow": ["_meta", "_id"]
			}
		],
		"typescript/no-explicit-any": "error"
	},
	"overrides": [
		{
			"files": ["src/social/**/*"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"paths": [
							{
								"name": "express",
								"message": "social layer must not import express (ADR-0080)"
							}
						],
						"patterns": [
							{
								"group": ["**/mastodon/**", "../mastodon/**", "./mastodon/**"],
								"message": "social layer must not import mastodon layer (ADR-0080)"
							}
						]
					}
				]
			}
		},
		{
			"files": ["src/projections/**/*"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": ["**/mastodon/**", "../mastodon/**", "**/social/**", "../social/**"],
								"message": "projections must not import social or mastodon layers (ADR-0082)"
							}
						]
					}
				]
			}
		},
		{
			"files": ["src/denormalizations.ts"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": ["**/mastodon/**", "./mastodon/**"],
								"message": "denormalizations must not import mastodon layer (ADR-0080)"
							}
						]
					}
				]
			}
		}
	]
}
